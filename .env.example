# Optional server-side key. The local game’s Connect Claude form writes .env.local.
# Never prefix this key with VITE_: that would expose it to the browser bundle.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# The default is claude-haiku-4-5. Override in the shell before npm run dev if needed.

# Optional public Mapbox token for satellite imagery. Restart Vite after editing.
# This VITE_ value is exposed to the browser; never put a secret token here.
VITE_MAPBOX_ACCESS_TOKEN=
